# 复制为 .env 后填写;.env 含敏感信息,勿提交/外发

# Web 工作台访问令牌(必填):容器监听 0.0.0.0,未设置时服务拒绝启动。
# 生成: python -c "import secrets;print(secrets.token_urlsafe(32))"
VH_WEB_TOKEN=

# 可选:LLM 文案改写(OpenAI 兼容接口),不填则 rewrite 直通原文
# VH_LLM_API_KEY=
# VH_LLM_BASE_URL=https://api.deepseek.com
# VH_LLM_MODEL=deepseek-chat

# 可选:前后端分离部署时的跨域白名单(逗号分隔);同源部署留空
# VH_CORS_ORIGINS=https://studio.example.com

# 可选:单个素材上传上限(MB)
# VH_MAX_UPLOAD_MB=2048
